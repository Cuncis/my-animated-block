{
  "$schema": "https://json-schema.org/schemas/block.json",
  "apiVersion": 3,
  "name": "my-animated-block/testimonials",
  "version": "1.0.0",
  "title": "Testimonials",
  "category": "mab-site",
  "icon": "format-quote",
  "description": "Customer quotes shown as a grid or a swipeable slider.",
  "keywords": [
    "testimonials",
    "reviews",
    "quotes",
    "social proof"
  ],
  "textdomain": "my-animated-block",
  "attributes": {
    "layout": {
      "type": "string",
      "enum": [
        "grid",
        "slider"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "number",
      "default": 3
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}