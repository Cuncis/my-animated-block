{
	"$schema": "https://json-schema.org/schemas/block.json",
	"apiVersion": 3,
	"name": "my-animated-block/feature-grid",
	"version": "1.0.0",
	"title": "Feature Grid",
	"category": "mab-site",
	"icon": "screenoptions",
	"description": "A responsive grid of feature cards, each with an icon, title and text.",
	"keywords": [ "features", "services", "benefits", "grid", "cards" ],
	"textdomain": "my-animated-block",
	"attributes": {
		"columns": { "type": "number", "default": 3 }
	},
	"styles": [
		{ "name": "card", "label": "Card", "isDefault": true },
		{ "name": "plain", "label": "Plain" }
	],
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
