{
	"$schema": "https://json-schema.org/schemas/block.json",
	"apiVersion": 3,
	"name": "my-animated-block/post-grid",
	"version": "1.0.0",
	"title": "Post Grid",
	"category": "mab-site",
	"icon": "grid-view",
	"description": "Your latest posts as cards, with optional category filter buttons.",
	"keywords": [ "posts", "blog", "grid", "articles", "filter", "news" ],
	"textdomain": "my-animated-block",
	"attributes": {
		"count": { "type": "number", "default": 6 },
		"columns": { "type": "number", "default": 3 },
		"categoryIds": {
			"type": "array",
			"default": [],
			"items": { "type": "number" }
		},
		"showFilters": { "type": "boolean", "default": true },
		"showImage": { "type": "boolean", "default": true },
		"showDate": { "type": "boolean", "default": true },
		"showExcerpt": { "type": "boolean", "default": true },
		"excerptLength": { "type": "number", "default": 20 }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
