		"@wordpress/i18n": "^7.1.0",
		"gsap": "^3.15.1"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.2.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/server-side-render": "^7.2.0",
		"autoprefixer": "^10.4.21",
		"postcss": "^8.5.6",
		"tailwindcss": "^3.4.19",
		"typescript": "~5.9.3"
