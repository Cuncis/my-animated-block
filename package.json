{
	"name": "my-animated-block",
	"version": "1.2.0",
	"description": "A lightweight block library for building whole sites without a page builder.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"files": [
		"build",
		"includes",
		"my-animated-block.php"
	],
