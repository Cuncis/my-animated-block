{
	"name": "@wordpress/preferences",
	"version": "5.1.0",
	"description": "Utilities for managing WordPress preferences.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"gutenberg",
		"preferences",
		"settings",
		"options"
	],
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/packages/preferences/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/WordPress/gutenberg.git",
		"directory": "packages/preferences"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"files": [
		"src",
		"build",
		"build-module",
		"build-style",
		"build-types"
	],
	"main": "build/index.cjs",
	"module": "build-module/index.mjs",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./package.json": "./package.json",
		"./build-style/*": "./build-style/*"
	},
	"wpScript": true,
	"types": "build-types",
	"wpScriptExtraDependencies": [
		"wp-preferences-persistence"
	],
	"sideEffects": false,
	"dependencies": {
		"@wordpress/a11y": "^5.1.0",
		"@wordpress/base-styles": "^15.0.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/compose": "^9.1.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/deprecated": "^5.1.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/icons": "^20.0.0",
		"@wordpress/private-apis": "^3.1.0"
	},
	"devDependencies": {
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"gitHead": "9b70363b9f93cff0583a1f3153738d383cf5a49e"
}
